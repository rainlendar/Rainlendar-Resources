msgstr "Tuntematon vastaus kutsuun \"%s\"."

msgid ""
"Call \"%s\" failed:\n"
"%s"
msgstr "Kutsu \"%s\" epäonnistui: %s"

msgid "Call to method \"%s\" failed."
msgstr "Kutsu metodiin \"%s\" epäonnistui."

msgid "Remember The Milk Error (%s)!"
msgstr "Remember The Milk -virhe (%s)!"

msgid "List"
msgstr "Lista"

msgid ""
"Choose the name of the task list from the Remember The Milk. You can also "
"leave the field empty if you want to get all your lists."
msgstr ""
"Valitse Remember The Milk -tehtävälistan nimi. Jätä tyhjäksi, jos haluat "
"hakea kaikki listat."

msgid ""
"Authentication token is missing. You need to give Rainlendar access to your "
"Remember The Milk account."
msgstr "Tunnistautumisavain puuttuu. Anna Rainlendarille käyttöoikeus tiliisi."

